<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/bg_red_yellow_gradient_button">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/root_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
      >

        <!-- Grouped Section CardView: added id + constraints, width=0dp for constraint layout -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_section"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:cardCornerRadius="12dp"
            app:cardBackgroundColor="@color/white"
            app:cardElevation="6dp"
            app:cardUseCompatPadding="true"
            android:padding="4dp">

            <!-- inner container uses a small margin so card corners stay visible -->
            <LinearLayout
                android:id="@+id/section_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"

                android:layout_margin="2dp"
                android:padding="10dp"
                >
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/titlename"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Registration"
                        android:textSize="24sp"
                        android:layout_gravity="center"
                        android:layout_marginBottom="8dp"
                        android:fontFamily="serif"
                        android:textColor="#01579B"
                        android:textStyle="bold" />

                    <!-- 🔹 Thin line below title -->
                    <View
                        android:layout_width="100dp"
                        android:layout_height="2dp"
                        android:visibility="gone"
                        android:layout_gravity="center"
                        android:background="#E77007"
                        android:layout_marginBottom="20dp" />

                </LinearLayout>

                <!-- First Name and Last Name -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_first_name"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="First Name"
                        android:layout_marginEnd="8dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_first_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_last_name"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="Last Name"
                        android:layout_marginStart="8dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_last_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <!-- Email -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_email"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Email"
                    android:layout_marginTop="12dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_email"
                        android:inputType="textEmailAddress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Phone -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_phone"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Phone Number"
                    android:layout_marginTop="12dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_phone"
                        android:inputType="phone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Swayamsiddha Spinner -->
<!--                <Spinner-->
<!--                    android:id="@+id/spinner_swayamsiddha"-->
<!--                    android:layout_width="match_parent"-->
<!--                    android:layout_height="wrap_content"-->
<!--                    android:layout_marginTop="12dp"-->
<!--                    android:contentDescription="Swayamsiddha" />-->
                <!-- State -->
                <Spinner
                    android:id="@+id/spinner_state"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    style="@style/CustomEditTextStyle"
                    android:spinnerMode="dropdown"
                    android:layout_marginBottom="16dp"
                    android:contentDescription="State" />

                <!-- District -->
                <Spinner
                    android:id="@+id/spinner_district"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/CustomEditTextStyle"
                    android:spinnerMode="dropdown"
                    android:layout_marginBottom="16dp"
                    android:contentDescription="District" />

                <!-- Taluka -->
                <Spinner
                    android:id="@+id/spinner_taluka"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/CustomEditTextStyle"
                    android:spinnerMode="dropdown"
                    android:layout_marginBottom="16dp"
                    android:contentDescription="Taluka" />
                <!-- Address -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_address"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Address"
                    android:layout_marginTop="12dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_address"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- DOB -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_dob"

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Date of Birth"
                    android:layout_marginTop="12dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_dob"
                        android:focusable="false"
                        android:clickable="true"
                        android:inputType="none"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </com.google.android.material.textfield.TextInputLayout>




                                <Spinner
                                    android:id="@+id/spinner_swayamsiddha"
                                    android:layout_width="match_parent"
                                    android:background="@drawable/rounded_input"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="12dp">

                                </Spinner>

                <!-- AdiShakti spinner -->
                <Spinner
                    android:id="@+id/spinner_adishakti"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" />

                <!-- Role spinner (for AdiShakti roles). Hidden by default -->
                <Spinner
                    android:id="@+id/spinner_role_adi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    android:layout_marginTop="8dp" />


                <!-- Password -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_password"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Password"
                    android:layout_marginTop="12dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_password"
                        android:inputType="textPassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:importantForAutofill="no" />
                </com.google.android.material.textfield.TextInputLayout>



            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Extended Form CardView: removed duplicate xmlns, constrained to card_section -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_extended_form"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            app:layout_constraintTop_toBottomOf="@id/card_section"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:cardCornerRadius="12dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="@color/white"
            app:cardUseCompatPadding="true">

            <!-- keep a small margin so card corners remain visible when inner background present -->
            <LinearLayout
                android:id="@+id/extended_form_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_margin="2dp"
                android:background="@color/white"
                android:padding="12dp">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"

                    android:elevation="12dp"
                    >

                    <!-- Text Information in Vertical Layout -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"

                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/titlename2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Swayamsiddha Information"
                            android:textSize="20sp"
                            android:layout_marginBottom="20dp"
                            android:fontFamily="serif"
                            android:textColor="#01579B"
                            android:textStyle="bold" />
                    </LinearLayout>

                </LinearLayout>

                <Spinner
                    android:id="@+id/spinner_role"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"

                    style="@style/CustomEditTextStyle"
                    android:spinnerMode="dropdown"
                    android:contentDescription="Role" />

                <Spinner
                    android:id="@+id/spinner_departments"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    style="@style/CustomEditTextStyle"
                    android:spinnerMode="dropdown"
                    android:contentDescription="Department" />

                <Spinner
                    android:id="@+id/spinner_stream"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    style="@style/CustomEditTextStyle"
                    android:spinnerMode="dropdown"
                    android:contentDescription="Stream" />

                <Spinner
                    android:id="@+id/spinner_university"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/CustomEditTextStyle"
                    android:spinnerMode="dropdown"
                    android:layout_marginTop="8dp"
                    android:contentDescription="University" />

                <Spinner
                    android:id="@+id/spinner_college"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    style="@style/CustomEditTextStyle"
                    android:spinnerMode="dropdown"
                    android:contentDescription="College" />

                <Spinner
                    android:id="@+id/spinner_schools"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    style="@style/CustomEditTextStyle"
                    android:spinnerMode="dropdown"
                    android:contentDescription="School" />

                <Spinner
                    android:id="@+id/spinner_studycentre"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    style="@style/CustomEditTextStyle"
                    android:spinnerMode="dropdown"
                    android:contentDescription="Study Centre" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Agree to Terms: constrain to card_extended_form (card), not inner layout -->
        <CheckBox
            android:id="@+id/cb_agree"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="I agree to the Terms"
            android:textSize="14sp"
            app:layout_constraintTop_toBottomOf="@id/card_extended_form"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Register Button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_register"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Register"
            android:textStyle="bold"
            style="@style/AppButtonStyle"
             android:layout_margin="20dp"

            app:layout_constraintTop_toBottomOf="@id/cb_agree"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />


    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
