<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="160dp"
    android:layout_height="220dp"
    android:layout_margin="6dp"
    android:background="@drawable/bg_reel_item"
    android:padding="6dp">

    <!-- PlayerView -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/fullscreenPlayerView"
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:layout_gravity="center"
        app:resize_mode="zoom"
        app:use_controller="false"
        android:visibility="invisible" />

    <!-- Thumbnail -->
    <ImageView
        android:id="@+id/imgReelThumb"
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:scaleType="centerCrop"
        android:visibility="visible" />

    <!-- Reel title -->
    <TextView
        android:id="@+id/tvReelTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#80000000"
        android:padding="4dp"
        android:text="Reel"
        android:textColor="#FFFFFF"
        android:textSize="14sp" />

    <!-- 🔊 Sound toggle icon -->
    <ImageView
        android:id="@+id/ivSoundToggle"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="8dp"
        android:padding="6dp"
        android:background="@drawable/bg_circle_translucent"
        android:src="@drawable/outline_volume_up_24"
        android:visibility="gone" />

</FrameLayout>
