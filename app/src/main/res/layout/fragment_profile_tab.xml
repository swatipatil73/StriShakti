<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scrollProfile"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:padding="16dp"
    tools:context=".ProfileTabFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Progress (centered horizontally) -->
        <ProgressBar
            android:id="@+id/progressProfile"
            style="?android:attr/progressBarStyle"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:visibility="gone"
            android:indeterminate="true"
            android:layout_marginBottom="8dp" />

        <!-- Cover Image -->
        <ImageView
            android:id="@+id/imageCover"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:scaleType="centerCrop"
            android:background="#EAEAEA"
            android:src="@drawable/bg_gradient_button" />

        <!-- Profile Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:background="@drawable/bg_profile_card"
            android:elevation="4dp"
            android:layout_marginTop="-50dp"
            android:layout_marginBottom="16dp"
            android:clipToPadding="false"
            android:clipChildren="false">

            <!-- Profile Image -->
            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/imageProfile"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@drawable/user"
                android:layout_marginEnd="16dp" />

            <!-- Info Block -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- Full Name -->
                <TextView
                    android:id="@+id/tvFullName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Full Name"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#222222"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/etFullName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    android:hint="Full Name"
                    android:inputType="textPersonName"
                    android:background="@android:color/transparent"
                    android:textColor="#222222"
                    android:textSize="20sp"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginBottom="4dp" />

                <!-- Username -->
                <TextView
                    android:id="@+id/tvUsername"
                    style="@style/ProfileText" />

                <!-- Email -->
                <TextView
                    android:id="@+id/tvEmail"
                    style="@style/ProfileText" />
            </LinearLayout>
        </LinearLayout>

        <!-- Details Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_detail_card"
            android:padding="16dp"
            android:elevation="2dp"
            android:layout_marginBottom="20dp">

            <!-- Gender -->
            <TextView
                android:id="@+id/tvGender"
                style="@style/ProfileText" />

            <!-- Bio -->
            <TextView
                android:id="@+id/tvBio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Bio"
                android:textColor="#444"
                android:drawableStart="@drawable/baseline_timeline_24"
                android:drawablePadding="8dp"
                android:textSize="15sp"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etBioEditable"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:drawableStart="@drawable/baseline_timeline_24"
                android:drawablePadding="8dp"
                android:hint="Write your bio here..."
                android:textColor="#444"
                android:textSize="15sp"
                android:background="@android:color/transparent"
                android:inputType="textMultiLine"
                android:minLines="3"
                android:layout_marginBottom="6dp" />

            <!-- Date of Birth -->
            <TextView
                android:id="@+id/tvBirth"
                android:drawableStart="@drawable/baseline_calendar_month_24"
                android:drawablePadding="8dp"
                style="@style/ProfileText" />

            <EditText
                android:id="@+id/etDob"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:hint="Date of Birth"
                android:drawableStart="@drawable/baseline_calendar_month_24"
                android:drawablePadding="8dp"
                android:inputType="none"
                android:background="@android:color/transparent"
                android:textColor="#444"
                android:textSize="15sp"
                android:focusable="false"
                android:clickable="true"
                android:layout_marginBottom="6dp" />

            <!-- Location -->
            <TextView
                android:id="@+id/tvLocationDistrict"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Location"
                android:textSize="15sp"
                android:drawableStart="@drawable/baseline_location_on_24"
                android:drawablePadding="8dp"
                android:textColor="#444444"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:hint="Address"
                android:drawableStart="@drawable/baseline_location_on_24"
                android:drawablePadding="8dp"
                android:inputType="textPostalAddress"
                android:background="@android:color/transparent"
                android:textColor="#444"
                android:textSize="15sp"
                android:layout_marginBottom="6dp" />

            <!-- Hobbies / Organization -->
            <TextView
                android:id="@+id/tvHobbies"
                android:drawableStart="@drawable/baseline_color_lens_24"
                android:drawablePadding="8dp"
                style="@style/ProfileText" />

            <!-- Organization Spinner (visible in edit mode) -->
            <Spinner
                android:id="@+id/spinnerOrg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:layout_marginTop="4dp"
                android:spinnerMode="dropdown" />

            <EditText
                android:id="@+id/etHobbies"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:drawableStart="@drawable/baseline_color_lens_24"
                android:drawablePadding="8dp"
                android:hint="Hobbies (comma separated)"
                android:inputType="text"
                android:background="@android:color/transparent"
                android:textColor="#444"
                android:textSize="15sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- Edit Profile Button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnEditProfile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Edit Profile"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:fontFamily="sans-serif"
            android:background="@drawable/button_background"
            android:layout_marginBottom="16dp" />
    </LinearLayout>
</ScrollView>
