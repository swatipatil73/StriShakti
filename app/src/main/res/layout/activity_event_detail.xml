<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".EventDetailActivity">

    <LinearLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:gravity="center_horizontal">

        <!-- Simple toolbar (back + title) -->
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:popupTheme="@style/ThemeOverlay.AppCompat.Light"
            app:titleTextAppearance="@style/TextAppearance.AppCompat.Title"
            app:title="dddd" />

        <!-- Header image -->
        <ImageView
            android:id="@+id/imgEventHeader"
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:scaleType="centerCrop"
            android:contentDescription="Event image"
            android:adjustViewBounds="true"
            android:src="@drawable/strishaktilogo" />

        <!-- Title row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"

            android:layout_marginTop="12dp">

            <TextView
                android:id="@+id/tvEventName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Event Title"
                android:textSize="20sp"
                android:gravity="center"
                android:textStyle="bold"
                android:textColor="#111111"
                android:fontFamily="sans-serif-medium" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="6dp"
                >

                <TextView
                    android:id="@+id/tvCategory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="music"
                    android:textSize="13sp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:background="@drawable/bg_tag"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/tvDistrict"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" • Pune"
                    android:textSize="13sp"
                    android:textColor="#777"
                    android:layout_marginStart="8dp" />

            </LinearLayout>
        </LinearLayout>

        <!-- Action buttons: Join / View Participants / Delete -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:layout_marginTop="10dp">



            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnJoin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="View Participants"
                android:insetLeft="8dp"
                android:insetRight="8dp"
                android:paddingHorizontal="12dp"
                android:fontFamily="sans-serif-medium"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDeleteEvent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Delete"
                android:insetLeft="8dp"
                android:insetRight="8dp"
                android:paddingHorizontal="12dp"
                android:fontFamily="sans-serif-medium"
                app:cornerRadius="12dp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Host + Mode + Dates Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardCornerRadius="12dp"
            android:padding="12dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/imgHostAvatar"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:src="@drawable/user"
                        android:scaleType="centerCrop"
                        android:contentDescription="Host" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp">

                        <TextView
                            android:id="@+id/tvHostName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Host Name"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-medium" />

                        <TextView
                            android:id="@+id/tvEventMode"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="offline"
                            android:textSize="12sp"
                            android:textColor="#777"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <!-- start/end short -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="end">

                        <TextView
                            android:id="@+id/tvStartDateShort"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Start: 15 Nov 2025"
                            android:textSize="12sp"
                            android:textColor="#333" />

                        <TextView
                            android:id="@+id/tvEndDateShort"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="End: 26 Nov 2025"
                            android:textSize="12sp"
                            android:textColor="#333" />
                    </LinearLayout>

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="10dp"
                    android:background="#E6E6E6" />

                <!-- Time row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/baseline_timeline_24"
                        android:contentDescription="time" />

                    <TextView
                        android:id="@+id/tvEventTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="16:46 - 14:52"
                        android:layout_marginStart="8dp"
                        android:textSize="14sp"
                        android:textColor="#555" />
                </LinearLayout>

                <!-- Location / Address -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="10dp"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/baseline_location_on_24"
                        android:contentDescription="location" />

                    <TextView
                        android:id="@+id/tvLocationFull"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="kasarawadi pudhe nagar, Pune"
                        android:layout_marginStart="8dp"
                        android:textSize="14sp"
                        android:textColor="#555" />
                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Description -->
        <TextView
            android:id="@+id/tvDescriptionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="About the event"
            android:textStyle="bold"
            android:layout_marginTop="14dp"
            android:textSize="16sp"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/tvDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Event description will appear here..."
            android:textSize="14sp"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="2dp"
            android:textColor="#444" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="14dp"
            android:background="@android:color/transparent" />

        <!-- Discussion header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvDiscussionTitle"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Host Infromation"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDiscussionCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="#777" />
        </LinearLayout>

        <!-- Discussion list (RecyclerView) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvDiscussion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:nestedScrollingEnabled="false" />

        <!-- Loading / empty -->
        <ProgressBar
            android:id="@+id/progressLoading"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:visibility="gone"
            android:layout_marginTop="12dp" />

        <TextView
            android:id="@+id/tvEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No discussion yet"
            android:gravity="center"
            android:visibility="gone"
            android:layout_marginTop="12dp"
            android:textColor="#777" />

        <!-- Bottom spacing -->
        <View
            android:layout_width="match_parent"
            android:layout_height="18dp" />

    </LinearLayout>

</ScrollView>